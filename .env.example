DATABASE_URL=postgres://sarim:local-development-only@localhost:5432/idea_universe
SESSION_SECRET=replace-with-at-least-48-random-characters-before-starting
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:8787
NODE_ENV=development
# Optional: public GitHub requests work without a token, subject to rate limits.
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
NETLIFY_TOKEN=
NETLIFY_ACCOUNT_SLUG=sarimsheikh1
# Hosted media: configure all three. Local uploads are development only.
S3_BUCKET=
S3_REGION=
MEDIA_PUBLIC_URL=
# AWS credentials use the standard server-side credential chain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
# Capture must run inside an isolated worker with enforced public-only egress.
CAPTURE_EGRESS_ISOLATED=false
