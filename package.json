{
  "name": "sarim-idea-universe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/src/index.ts\" \"vite --config client/vite.config.ts\"",
    "build": "npm run typecheck && vite build --config client/vite.config.ts && tsc -p server/tsconfig.json",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json --noEmit",
    "start": "node server/dist/server/src/index.js",
    "db:migrate": "tsx server/src/cli.ts migrate",
    "owner:create": "tsx server/src/cli.ts owner",
    "import:github": "tsx server/src/cli.ts import",
    "capture": "tsx server/src/capture.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "package": "node scripts/package.mjs",
    "seed:verified": "tsx scripts/seed.ts",
    "owner:configure": "tsx server/src/cli.ts owner-configured"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@electric-sql/pglite": "^0.5.9",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "argon2": "^0.44.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.0",
    "gsap": "^3.13.0",
    "helmet": "^8.0.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/connect-pg-simple": "^7.0.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "archiver": "^7.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
